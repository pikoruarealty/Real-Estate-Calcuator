# Public site URL (used for share links, metadata, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Advisor WhatsApp number with country code, digits only. Defaults to 916354359222 (src/config/brand.ts); set empty to hide the button.
NEXT_PUBLIC_ADVISOR_WHATSAPP=916354359222
# Generic JSON webhook that receives leads (POST). If empty, leads are console.info'd.
LEAD_WEBHOOK_URL=
# Plausible analytics domain. Script is only loaded when set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
